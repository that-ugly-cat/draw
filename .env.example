# Copy to .env and fill in. The .env is not versioned.

# Required. Signs session cookies in local mode.
#   openssl rand -base64 36
JWT_SECRET=

# local | gateway
# `local` is the code's own default, and it is also the way back in when the
# gate is down: a restart with the variable changed, not an emergency procedure.
AUTH_MODE=local

# Gateway mode only. Where the proxy is expected to come from, as a list.
# Under Docker this is the bridge network gateway and NOT 127.0.0.1, and it has
# to be widened every time a network is added to the container: Docker picks
# between gateways in alphabetical order of network name, so a new network can
# move the address and switch off the login without saying why.
BORANT_TRUSTED_PROXY=127.0.0.1

# Gateway mode only, and optional. Where the gate ends a session.
# A URL rather than a hardwired constant, because this app must keep working
# with no gate anywhere in sight. Left empty, the app stops offering a sign-out
# it cannot perform instead of clearing nothing while the gate cookie lives on.
GATE_LOGOUT_URL=

# The address this app is reached at from outside. The MCP transport validates
# the Host header against DNS rebinding and refuses any name it does not know,
# so a missing value here looks like a broken tool rather than a missing
# variable -- and it does not reproduce from the machine itself, because on
# 127.0.0.1 the same call works.
PUBLIC_URL=http://localhost:8023

# Where the page loads the editor iframe from.
# In production this is a path on the same host, so the iframe stays same-origin.
# Locally, pointing at the container: http://localhost:8024/
EDITOR_URL=/editor/

# Where the database lives.
DATA_DIR=data
