# Copiare in .env e riempire. Il .env non è versionato.

# Obbligatorio. Firma i cookie di sessione in modalità local.
#   openssl rand -base64 36
JWT_SECRET=

# local | gateway
# `local` è il default del codice, ed è anche la via di ritorno quando il gate
# è giù: un riavvio con la variabile cambiata, non una procedura d'emergenza.
AUTH_MODE=local

# Solo in gateway. Da dove ci si aspetta il proxy, come lista.
# Sotto Docker è il gateway della rete bridge e NON 127.0.0.1, e va allargato
# ogni volta che si aggiunge una rete al container: Docker sceglie fra i
# gateway in ordine alfabetico di nome di rete, quindi una rete nuova può
# spostare l'indirizzo e spegnere il login senza dire perché.
BORANT_TRUSTED_PROXY=127.0.0.1

# Da dove la pagina carica l'iframe dell'editor.
# In produzione è un path sullo stesso host, così l'iframe resta same-origin.
# In locale, puntando al container: http://localhost:8024/
EDITOR_URL=/editor/

# Dove sta il database.
DATA_DIR=data
